[Unit]
Description=Push verified Pumbum development commits to the isolated GitHub branch
After=network-online.target pumbum-hermes-mcp.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/agent-projects/pumbum-hermes-dev
Environment=PUMBUM_GIT_SYNC_WORKSPACE=%h/agent-projects/pumbum-hermes-dev
Environment=PUMBUM_GIT_SYNC_STATE_DIR=%h/.local/state/pumbum-hermes-dev
Environment=PUMBUM_GIT_SYNC_DATABASE=%h/.local/state/pumbum-hermes-dev/state.sqlite
Environment=PUMBUM_GIT_SYNC_REMOTE=github
Environment=PUMBUM_GIT_SYNC_REMOTE_URL=git@github.com:Big888Boss/pumbum_store.git
Environment=PUMBUM_GIT_SYNC_BRANCH=codex/hermes-seo-geo
Environment=PUMBUM_GIT_SYNC_KEY=%d/github_key
Environment=PUMBUM_GIT_SYNC_KNOWN_HOSTS=%d/github_known_hosts
LoadCredential=github_key:%h/.ssh/pumbum-hermes-github
LoadCredential=github_known_hosts:%h/.ssh/known_hosts
ExecStart=/usr/bin/python3 %h/.local/share/pumbum-hermes-dev/pumbum_dev_git_sync.py
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=%h/agent-projects/pumbum-hermes-dev
ReadOnlyPaths=%h/.local/share/pumbum-hermes-dev/pumbum_dev_git_sync.py
ReadWritePaths=%h/.local/state/pumbum-hermes-dev
InaccessiblePaths=%h/.ssh %h/.aws %h/.gnupg %h/.kube %h/.docker %h/ai-gateway
RestrictSUIDSGID=true
LockPersonality=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=256M
CPUQuota=50%
