FROM node:22.22.2-bookworm-slim

ARG CODEX_VERSION=0.151.0

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl git python3 python3-venv \
    && npm install --global "@openai/codex@${CODEX_VERSION}" \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/pumbum-hermes
COPY requirements.txt /opt/pumbum-hermes/requirements.txt
RUN python3 -m venv /opt/pumbum-hermes/venv \
    && /opt/pumbum-hermes/venv/bin/pip install --disable-pip-version-check --no-cache-dir --requirement /opt/pumbum-hermes/requirements.txt

COPY factory/pumbum_dev_common.py factory/pumbum_dev_worker.py /opt/pumbum-hermes/app/

RUN mkdir -p /home/agent /workspace /state /codex-home \
    && chown -R 1000:1000 /home/agent /workspace /state /codex-home

USER 1000:1000
WORKDIR /workspace

ENTRYPOINT ["/opt/pumbum-hermes/venv/bin/python", "/opt/pumbum-hermes/app/pumbum_dev_worker.py"]
