# Copy to ~/.config/pumbum-hermes-dev/runtime.env with mode 0600.
# Bind to the actual private Tailscale address, never to 0.0.0.0.
PUMBUM_DEV_TAILNET_HOST=replace-with-tailnet-ip
PUMBUM_DEV_MCP_HOST=replace-with-tailnet-ip
PUMBUM_DEV_PREVIEW_URL=http://replace-with-tailnet-ip:3032
NEXT_PUBLIC_SITE_URL=http://replace-with-tailnet-ip:3032
PUMBUM_DEV_CODEX_HOME=/replace-with-private-codex-home
PUMBUM_DEV_MCP_TOKEN=replace-with-private-token-at-least-32-characters
