[Unit]
Description=Vira Pumbum Dev - isolated Hermes Telegram Gateway
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=%h/.hermes/profiles/pumbum-dev/workspace
Environment=HERMES_HOME=%h/.hermes/profiles/pumbum-dev
Environment=HERMES_SHARED_AUTH_PATH=%h/.hermes/shared-auth/auth.json
Environment=PYTHONUNBUFFERED=1
Environment=VIRTUAL_ENV=%h/.hermes/releases/20260814T133920Z-c80d88678660/venv
Environment=PATH=%h/.hermes/releases/20260814T133920Z-c80d88678660/venv/bin:%h/.hermes/releases/20260814T133920Z-c80d88678660/node_modules/.bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=%h/.config/pumbum-hermes-dev/runtime.env
ExecStart=%h/.hermes/releases/20260814T133920Z-c80d88678660/venv/bin/python -m hermes_cli.main gateway run
ExecReload=/bin/kill -USR1 $MAINPID
ExecStopPost=-%h/.hermes/releases/20260814T133920Z-c80d88678660/venv/bin/python -m gateway.cgroup_cleanup
Restart=always
RestartSec=5
RestartForceExitStatus=75
TimeoutStopSec=900
KillMode=mixed
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=%h/pumbum-hermes-dev
ReadWritePaths=%h/.hermes/profiles/pumbum-dev
ReadWritePaths=%h/.hermes/shared-auth
MemoryMax=3G
TasksMax=512
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
