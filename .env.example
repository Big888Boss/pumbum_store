# Public canonical URL used by metadata, sitemap and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://477477.ru

# Keep non-production deployments closed in robots.txt.
# Use `production` only after final domain switch approval.
NEXT_PUBLIC_SITE_ENV=staging

# Optional analytics. Leave empty on staging if production metrics must stay clean.
# Current production 477477.ru counter found during read-only audit: 109783471.
# NEXT_PUBLIC_YANDEX_METRIKA_ID=109783471

# Lead storage. For VPS deployment, mount/backup this path or replace it with webhook delivery.
LEADS_STORAGE_PATH=.data/leads.jsonl

# Optional CRM/webhook delivery. Keep real values in server env only.
# LEADS_WEBHOOK_URL=
# LEADS_WEBHOOK_TOKEN=

# Anti-bot / rate limiting: the only request header trusted for the client IP.
# nginx must set this header itself and strip incoming CF-Connecting-IP,
# X-Real-IP and X-Forwarded-For from clients. Default: x-real-ip.
TRUSTED_CLIENT_IP_HEADER=x-real-ip
