{
  "name": "pumbum-store-v2",
  "version": "0.1.0",
  "private": true,
  "description": "Isolated V2 storefront for the plumbing store; legacy source data is read-only and normalized into production catalog routes.",
  "scripts": {
    "dev": "next dev -p ${PORT:-3010}",
    "build": "node scripts/write-catalog-health.mjs && next build",
    "start": "next start -p ${PORT:-3010}",
    "lint": "eslint src scripts --ext .ts,.tsx,.js,.mjs",
    "check:isolation": "node scripts/check-isolation.mjs",
    "catalog:import-legacy": "node scripts/import-legacy-catalog.mjs",
    "catalog:normalize-suppliers": "node scripts/normalize-product-suppliers.mjs",
    "catalog:import-espa": "node scripts/import-espa-catalog.mjs",
    "catalog:validate-espa": "node scripts/validate-espa-catalog.mjs",
    "catalog:write-health": "node scripts/write-catalog-health.mjs",
    "security:check-csp": "node scripts/check-csp-runtime.mjs",
    "security:check-load": "node scripts/check-runtime-load.mjs",
    "analytics:check": "node scripts/check-metrika-contract.mjs",
    "analytics:check-browser": "node scripts/check-metrika-browser.mjs",
    "catalog:check-pagination": "node scripts/check-category-pagination.mjs",
    "catalog:check-taxonomy": "node scripts/check-category-taxonomy.mjs",
    "catalog:check-navigation": "node scripts/check-category-taxonomy.mjs",
    "catalog:check-carousels-browser": "node scripts/check-category-carousels-browser.mjs",
    "redesign:check-browser": "node scripts/check-redesign-browser.mjs",
    "catalog:check-legacy-purpose-redirects": "node scripts/check-legacy-purpose-redirect-coverage.mjs",
    "images:audit": "node scripts/audit-product-images.mjs",
    "images:normalize": "node scripts/normalize-product-images.mjs",
    "images:audit-transparency": "node scripts/process-product-transparency.mjs",
    "images:process-transparency": "node scripts/process-product-transparency.mjs --process",
    "images:apply-sinikon-source": "node scripts/apply-sinikon-source-images.mjs",
    "images:apply-aquatec-source": "node scripts/apply-aquatec-source-images.mjs",
    "images:repair-manifest-suppliers": "node scripts/repair-product-image-manifest-suppliers.mjs",
    "images:convert-webp": "node scripts/convert-product-images-to-webp.mjs",
    "seo:inventory": "node scripts/legacy-catalog-inventory.mjs",
    "seo:generate-legacy-redirects": "node scripts/generate-legacy-route-redirects.mjs",
    "seo:check-legacy-redirects": "node scripts/check-legacy-route-redirects.mjs",
    "seo:crawl": "node scripts/seo-crawl.mjs",
    "smoke:overlay": "node scripts/browser-smoke-task130.mjs",
    "check:ocr-images": "node scripts/ocr-task130-images.mjs"
  },
  "dependencies": {
    "@next/env": "15.5.21",
    "lucide-react": "1.25.0",
    "next": "15.5.21",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "0.35.3",
    "zod": "^3.23.8"
  },
  "overrides": {
    "js-yaml": "^4.3.0",
    "postcss": "^8.5.16",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "15.5.21",
    "playwright": "^1.60.0",
    "tesseract.js": "^7.0.0",
    "typescript": "^5.5.0"
  },
  "type": "module"
}
